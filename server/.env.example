# --- TikTok (Login Kit + Content Posting API + Webhooks) ---
# Values come from the TikTok Developer Portal app "M1 Store". NEVER commit real values.
# Tokens are encrypted at rest with SECRET_ENCRYPTION_KEY (or JWT_SECRET as fallback).
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Dedicated TikTok token-encryption key. NOT shared with SECRET_ENCRYPTION_KEY
# or JWT_SECRET: those bind the existing Meta/Instagram ciphertext, and reusing
# them would couple a TikTok key rotation to live Meta tokens. Required whenever
# TIKTOK_ENABLED=true — there is no fallback, the integration refuses to start
# without it. Generate with: openssl rand -hex 32
TIKTOK_ENCRYPTION_KEY=
# Must be HTTPS, with no query string and no fragment, and must match the portal exactly.
TIKTOK_REDIRECT_URI=https://api.m1store-egy.com/api/tiktok/oauth/callback
# Webhook Callback URL registered in the portal: https://api.m1store-egy.com/api/webhooks/tiktok
# TikTok signs with the client secret, so there is no separate webhook secret.
TIKTOK_WEBHOOK_ENABLED=false
TIKTOK_WEBHOOK_TOLERANCE_SECONDS=300
TIKTOK_INTAKE_POLL_INTERVAL_MS=10000
# Optional override; defaults to user.info.basic,video.upload,video.publish
TIKTOK_SCOPES=

# --- TikTok API for Business (Accounts API: organic comments) ---
# SEPARATE app from the Login Kit one above: "M1 Store ERP" on
# business-api.tiktok.com, approved 2026-08-28 with TikTok Accounts >
# Account Comment (Get + Manage). Different credentials (app_id/app_secret,
# NOT client_key/client_secret), different token namespace (tkb:v1).
TIKTOK_BUSINESS_ENABLED=false
# App ID + Secret from My Apps > App Detail > Basic Information.
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=
# The "TikTok account holder authorization URL", copied VERBATIM from
# My Apps > App Detail > Basic Information. It embeds the app's client_key and
# approved scopes; the ERP only appends &state= to it.
TIKTOK_BUSINESS_AUTHORIZE_URL=
# Must match the registered "TikTok account holder redirect URL" byte-for-byte.
# TikTok's rules: https, no query, no fragment, no port, MUST end with "/".
TIKTOK_BUSINESS_REDIRECT_URI=https://api.m1store-egy.com/api/tiktok-business/oauth/callback/
# Dedicated encryption key for Business tokens. No fallback to JWT_SECRET,
# SECRET_ENCRYPTION_KEY, or TIKTOK_ENCRYPTION_KEY — by design (key isolation).
# Generate with: openssl rand -hex 32
TIKTOK_BUSINESS_ENCRYPTION_KEY=
# Comments feature gate (list + reply + poll worker).
TIKTOK_BUSINESS_COMMENTS_ENABLED=false
# comment.update webhook intake at /api/webhooks/tiktok-business. Register the
# callback with TikTok via POST /business/webhook/update/ after enabling.
TIKTOK_BUSINESS_WEBHOOK_ENABLED=false
TIKTOK_BUSINESS_WEBHOOK_TOLERANCE_SECONDS=300
# Poll cadence for the comments worker (min 60000).
TIKTOK_BUSINESS_COMMENTS_POLL_INTERVAL_MS=300000
# LEAVE UNSET: Business Messaging is a separate permission that has not been
# requested or granted. Setting it changes nothing except surfacing an error.
# TIKTOK_BUSINESS_MESSAGING_ENABLED=
