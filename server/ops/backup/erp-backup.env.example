# Copy to /etc/erp-backup.env and chmod 600. Sourced by erp-backup.sh and erp-restore-test.sh.

# rclone remote the backups go to. Use the CRYPT remote (trailing colon), so the provider
# only ever holds encrypted bytes: the dumps contain customers' names, phones and addresses.
ERP_BACKUP_REMOTE="erp-backup:"

# Dead-man's switch (e.g. https://healthchecks.io, free). Create a check with a 1-day
# period and a 2-hour grace; it emails you when a backup fails OR simply stops running.
ERP_BACKUP_HEALTHCHECK_URL=""
# A second check with a 32-day period for the monthly restore test.
ERP_RESTORE_TEST_HEALTHCHECK_URL=""

PG_CONTAINER="erp-postgres"
PG_USER="erp_user"
PG_DATABASE="erp_production"
ERP_UPLOADS_DIR="/opt/erp/uploads"
ERP_BACKUP_LOCAL_DIR="/opt/erp/backups/nightly"
