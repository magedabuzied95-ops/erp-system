{
  "rewrites": [
    {
      "source": "/c/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/shop/confirm/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/share/product/(.*)",
      "destination": "https://erp-system-0qhp.onrender.com/share/product/$1"
    },
    {
      "source": "/share/available",
      "destination": "https://erp-system-0qhp.onrender.com/share/available"
    },
    {
      "source": "/share/available/og-image.png",
      "destination": "https://erp-system-0qhp.onrender.com/share/available/og-image.png"
    },
    {
      "source": "/share/available/(.*)",
      "destination": "https://erp-system-0qhp.onrender.com/share/available/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/fonts/(.*)",
      "destination": "/fonts/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
