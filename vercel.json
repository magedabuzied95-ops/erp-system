{
  "rewrites": [
    {
      "source": "/c/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/shop/confirm/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/shop/product/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|TelegramBot|LinkedInBot|Discordbot|Pinterest|Applebot|Googlebot|Bingbot).*"
        }
      ],
      "destination": "https://erp-system-0qhp.onrender.com/shop/product/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/fonts/(.*)",
      "destination": "/fonts/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
