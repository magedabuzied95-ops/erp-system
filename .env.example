VITE_GOOGLE_REVIEW_URL=https://g.page/r/Ccj4YSNAoHbVEAE/review
PUBLIC_APP_URL=https://m1store-egy.com
PUBLIC_BACKEND_URL=https://api.m1store-egy.com

# Telegram AI Inbox (keep secrets in the deployment secret store)
TELEGRAM_ENABLED=false
TELEGRAM_TENANT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INTAKE_POLL_INTERVAL_MS=10000
PUBLIC_BASE_URL=https://api.m1store-egy.com
PAYMOB_WEBHOOK_URL=${PUBLIC_BASE_URL}/api/paymob/webhook
META_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ENABLED=false
FACEBOOK_MESSENGER_ENABLED=false
WHATSAPP_ENABLED=false
WHATSAPP_AI_AUTO_REPLY=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_TENANT_ID=1
WHATSAPP_GATEWAY_PROVIDER=evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=m1-store-local-key
EVOLUTION_INSTANCE_NAME=qr-test2
# Local/dev only. Skips heavy startup integrations and syncs during smoke tests.
SKIP_STARTUP_SYNCS=false
WHATSAPP_WEBHOOK_SECRET=
META_TENANT_ID=1
META_GRAPH_VERSION=v20.0
PAYMOB_API_KEY=
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_AUTH_BASE_URL=https://accept.paymobsolutions.com/api
PAYMOB_STATUS_ENDPOINT=auto
PAYMOB_STATUS_METHOD=GET
PAYMOB_TERMINAL_ID=
PAYMOB_PREFERRED_METHOD=card
PAYMOB_ENABLED=false
PAYMOB_HMAC_SECRET=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPAPI_KEY=
OPENAI_API_KEY=
OPENAI_AGENT_API_KEY=
OPENAI_THERMAL_API_KEY=
ENABLE_AI_SHOE_COVER_GENERATION=false
OPENAI_SHOE_COVER_MODEL=gpt-image-1
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_VISION_FALLBACK_MODEL=gpt-4o
# Composition tier — what the customer actually reads. Raise this to the best model
# the account has access to; it is the single biggest quality lever in the AI stack.
AI_SUPPORT_MODEL=gpt-4o
# Classification tier — the understanding pass runs on every inbound message and only
# fills a small schema, so it stays cheap.
AI_FAST_MODEL=gpt-4o-mini
AI_SUPPORT_ENABLED=false
AI_SUPPORT_VISION_ENABLED=true
AI_SUPPORT_TIMEOUT_MS=25000
AI_SUPPORT_MAX_RETRIES=2
# Rate-limit backoff grows exponentially from the base up to the ceiling, and resets
# on the first success. Keep the base short: it gates ALL text generation.
AI_SUPPORT_QUOTA_BACKOFF_MS=30000
AI_SUPPORT_QUOTA_BACKOFF_MAX_MS=300000

# --- Understanding pass (intent, entities, funnel stage, sentiment) ---
# Off falls back to the deterministic keyword resolver, which is the pre-existing behaviour.
AI_UNDERSTANDING_ENABLED=false
AI_UNDERSTANDING_TIMEOUT_MS=8000
AI_UNDERSTANDING_CACHE_TTL_MS=900000

# Route a conversation to a human when the understanding pass says one is needed and
# the keyword list did not notice. The keyword list only matches an explicit request
# for a person, so today "عايز فلوسي ترجع" is classified as product discovery and the
# customer asking for a refund is answered with product suggestions.
# This only ever ADDS a handoff, never removes one — but that means more conversations
# reach a human, which is a staffing decision, so it is opt-in rather than a default.
AI_UNDERSTANDING_ESCALATION_ENABLED=false

# --- Tool-calling agent loop ---
# Off keeps the deterministic template composer as the only draft source.
# On, the model may query real inventory/shipping/policy/orders itself, and a draft
# whose claims do not all trace back to a successful tool call is discarded.
AI_AGENT_LOOP_ENABLED=false
AI_AGENT_LOOP_DEADLINE_MS=20000
RENDER_API_BASE_URL=https://api.m1store-egy.com
AI_REGRESSION_TEST_KEY=replace-with-a-secret
# Local runs only; the endpoint itself stays disabled unless Render enables it.
ENABLE_AI_REGRESSION_TEST_ENDPOINT=false
AI_RECOMMENDATION_MODE=clearance
MAX_STORY_SLIDES=6
EMPLOYEE_PORTAL_SESSION_MINUTES=720
# Optional self-hosted accounting analytics (Metabase).
# Keep METABASE_EMBEDDING_SECRET identical in the ERP backend and Metabase.
METABASE_SITE_URL=https://reports.m1store-egy.com
METABASE_ACCOUNTING_DASHBOARD_ID=
METABASE_EMBEDDING_SECRET=
METABASE_EMBED_TOKEN_TTL_SECONDS=600
METABASE_APP_DB_NAME=metabase
METABASE_APP_DB_USER=metabase
METABASE_APP_DB_PASSWORD=
METABASE_PORT=3000
METABASE_VERSION=latest
METABASE_JAVA_OPTS=-Xms256m -Xmx768m
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://m1store-egy.com
# Public storefront Google Analytics 4. Falls back safely to G-J47KZ3W60P.
VITE_GA4_MEASUREMENT_ID=G-J47KZ3W60P
VITE_GOOGLE_CUSTOMER_REVIEWS_MERCHANT_ID=5829421968
# Required only for the destructive catalog wipe script.
ALLOW_FULL_PRODUCT_DELETE=false

# Transactional order emails
ORDER_EMAILS_ENABLED=true
