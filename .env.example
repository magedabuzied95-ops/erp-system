ORDER_EMAIL_BATCH_SIZE=10
ORDER_EMAIL_POLL_INTERVAL_MS=30000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=orders@m1store-egy.com
MAIL_FROM_NAME=M1 Store
SUPPORT_EMAIL=support@m1store-egy.com
STORE_FACEBOOK_URL=
STORE_INSTAGRAM_URL=
STORE_TIKTOK_URL=
PUBLIC_APP_URL=https://m1store-egy.com
PUBLIC_BACKEND_URL=https://api.m1store-egy.com

# Manager Portal Daily Profit lock - bcrypt hash only, never plaintext
MANAGER_PROFIT_PIN_HASH=

# --- TikTok for Developers (Login Kit + Content Posting) --- LIVE
# App "M1 Store" on developers.tiktok.com. Publishing only: this app type has
# no DM API and no comment API. Do not reuse these credentials against
# business-api.tiktok.com.
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Dedicated TikTok token-encryption key. NOT shared with SECRET_ENCRYPTION_KEY
# or JWT_SECRET: those bind the existing Meta/Instagram ciphertext, and reusing
# them would couple a TikTok key rotation to live Meta tokens. Required whenever
# TIKTOK_ENABLED=true — there is no fallback, the integration refuses to start
# without it. Generate with: openssl rand -hex 32
TIKTOK_ENCRYPTION_KEY=
TIKTOK_REDIRECT_URI=
TIKTOK_WEBHOOK_ENABLED=false
TIKTOK_INTAKE_POLL_INTERVAL_MS=10000

# --- TikTok API for Business (Comments + Business Messaging) --- DORMANT
# App "M1 Store ERP" on business-api.tiktok.com. Status: PENDING review, so
# TIKTOK_BUSINESS_APP_ID does not exist yet and every flag below stays false.
# Separate app, separate credentials, separate token storage from the block
# above — the two are never interchangeable.
TIKTOK_BUSINESS_ENABLED=false
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=
# Advertiser redirect registered in the portal.
TIKTOK_BUSINESS_REDIRECT_URI=
# Per-feature gates. Each stays false until TikTok grants that specific
# capability; turning one on without the grant fails closed rather than
# degrading into a half-working integration.
TIKTOK_BUSINESS_COMMENTS_ENABLED=false
TIKTOK_BUSINESS_MESSAGING_ENABLED=false
TIKTOK_BUSINESS_WEBHOOK_ENABLED=false
# REQUIRED once TIKTOK_BUSINESS_ENABLED=true. Dedicated key with NO fallback to
# SECRET_ENCRYPTION_KEY, JWT_SECRET, or TIKTOK_ENCRYPTION_KEY — sharing one would
# mean a leak or rotation of those secrets also compromised or silently broke
# every stored TikTok Business token. Minimum 32 characters; generate with:
# openssl rand -hex 32. While the integration is disabled this may stay empty
# and the integration simply remains dormant.
TIKTOK_BUSINESS_ENCRYPTION_KEY=
