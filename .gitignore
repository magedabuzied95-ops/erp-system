# Surveillance Center. Same shape as the analytics package above: the directory
# itself must be un-ignored before anything inside it can be matched, and the
# nested provider/transport/media/repository folders need the `**` to survive.
!server/services/surveillance/
!server/services/surveillance/**
.codex-deploy*.zip
.codex-monitoring*.log
backups/
output/
tmp/
services/
# `services/` above is unanchored, so it swallows EVERY directory named
# "services" — including frontend source. That silently excluded a new
# src/modules/aiSupport/services/*.js module from a commit and broke the
# production build with UNRESOLVED_IMPORT (existing files there were unaffected
# only because tracked files ignore .gitignore). Frontend source is never build
# output: keep it committable.
!src/**/services/
!src/**/services/**
.codex-deploy*.zip
.codex-monitoring*.log
!server/services/
server/services/*
!server/services/chatPresenceService.js
!server/services/metaReviewerAccessService.js
