# Reporting & Analytics Center v2. `server/services/*` above ignores the whole
# directory, so the analytics package needs its directory un-ignored before its
# contents can be matched.
!server/services/analytics/
!server/services/analytics/**
.codex-deploy*.zip
.codex-monitoring*.log
backups/
output/
tmp/
services/
# `services/` above is unanchored, so it swallows EVERY directory named
# "services" — including frontend source. That silently excluded a new
# src/modules/aiSupport/services/*.js module from a commit and broke the
# production build with UNRESOLVED_IMPORT (existing files there were unaffected
# only because tracked files ignore .gitignore). Frontend source is never build
# output: keep it committable.
!src/**/services/
!src/**/services/**
.codex-deploy*.zip
.codex-monitoring*.log
!server/services/
server/services/*
!server/services/metaReviewerAccessService.js
!server/services/metaReviewerInboxService.js
!server/services/inboundMediaService.js
!server/services/aiWorkflow*.js
!server/services/aiRestockRecoveryService.js
!server/services/restockIntentService.js
!server/services/restockNotificationService.js
# Reporting & Analytics Center v2. `server/services/*` above ignores the whole
# directory, so the analytics package needs its directory un-ignored before its
# contents can be matched.
!server/services/analytics/
!server/services/analytics/**
